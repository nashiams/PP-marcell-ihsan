<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LaundryApp - Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">🧺 LaundryApp</a>
            <div class="navbar-nav ms-auto">
                <% if (isLoggedIn) { %>
                    <span class="navbar-text me-3">Welcome, <%= username %>!</span>
                    <a href="/logout" class="btn btn-outline-light">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-light me-2">Login</a>
                    <a href="/register" class="btn btn-light">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Success/Error Messages -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Hero Section -->
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h1 class="display-4 mb-3">Welcome to LaundryApp</h1>
                <p class="lead">Your trusted laundry service - fast, reliable, and affordable!</p>
                <% if (isLoggedIn) { %>
                    <a href="/order" class="btn btn-primary btn-lg">Place Order</a>
                    <a href="/status" class="btn btn-outline-primary btn-lg ms-2">Check Status</a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-lg me-2">Login to Order</a>
                    <a href="/register" class="btn btn-outline-primary btn-lg">Register Now</a>
                <% } %>
            </div>
        </div>

        <!-- Categories Section -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Our Services</h2>
                    
                    <!-- Search and Sort Form -->
                    <form method="GET" action="/" class="d-flex gap-2 align-items-center">
                        <input type="text" name="search" class="form-control" placeholder="Search services..." 
                               value="<%= search %>" style="width: 200px;">
                        <select name="sortBy" class="form-select" style="width: 150px;">
                            <option value="">Sort by</option>
                            <option value="price_asc" <%= sortBy === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                            <option value="price_desc" <%= sortBy === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                        </select>
                        <button type="submit" class="btn btn-outline-primary">Filter</button>
                        <% if (search || sortBy) { %>
                            <a href="/" class="btn btn-outline-secondary">Clear</a>
                        <% } %>
                    </form>
                </div>
                
                <% if (categories.length > 0) { %>
                    <div class="row">
                        <% categories.forEach(category => { %>
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title"><%= category.name %></h5>
                                        <p class="card-text">
                                            <strong>Price: Rp <%= category.price.toLocaleString('id-ID') %> /kg</strong>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="alert alert-info">
                        <% if (search) { %>
                            No services found matching "<%= search %>". <a href="/">View all services</a>
                        <% } else { %>
                            No services available at the moment.
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="mb-4">Customer Reviews</h2>
                <% if (reviews.length > 0) { %>
                    <div class="row">
                        <% reviews.forEach(review => { %>
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="card-title mb-0"><%= review.User.username %></h6>
                                            <div class="text-warning">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <% if (i <= review.rating) { %>
                                                        ⭐
                                                    <% } else { %>
                                                        ☆
                                                    <% } %>
                                                <% } %>
                                                <span class="text-muted">(<%= review.rating %>/5)</span>
                                            </div>
                                        </div>
                                        <p class="card-text"><%= review.text %></p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="alert alert-info">
                        No reviews yet. Be the first to leave a review!
                    </div>
                <% } %>
            </div>
        </div>

        <!-- User's Completed Orders (if logged in) -->
        <% if (isLoggedIn && userCompletedOrders.length > 0) { %>
            <div class="row mb-5">
                <div class="col-12">
                    <h2 class="mb-4">Your Completed Orders</h2>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Categories</th>
                                    <th>Total Price</th>
                                    <th>Completed Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% userCompletedOrders.forEach(order => { %>
                                    <tr>
                                        <td>#<%= order.id %></td>
                                        <td>
                                            <% order.Categories.forEach((category, index) => { %>
                                                <%= category.name %> (<%= category.OrderCategory.quantity %>kg)
                                                <% if (index < order.Categories.length - 1) { %>, <% } %>
                                            <% }); %>
                                        </td>
                                        <td>Rp <%= order.totalPrice.toLocaleString('id-ID') %></td>
                                        <td><%= new Date(order.updatedAt).toLocaleDateString('id-ID') %></td>
                                        <td>
                                            <% if (!order.Review) { %>
                                                <a href="/review/<%= order.id %>" class="btn btn-sm btn-primary">Review</a>
                                            <% } else { %>
                                                <span class="badge bg-success">Reviewed</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <footer class="bg-light mt-5 py-4">
        <div class="container text-center">
            <p class="mb-0">&copy; 2025 LaundryApp. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>