<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LaundryApp - Write Review</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">🧺 LaundryApp</a>
            <div class="navbar-nav ms-auto">
                <a href="/" class="btn btn-outline-light me-2">Home</a>
                <a href="/status" class="btn btn-outline-light me-2">Status</a>
                <a href="/logout" class="btn btn-outline-light">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Write Review for Order #<%= order.id %></h3>
                    </div>
                    <div class="card-body">
                        <!-- Display Errors -->
                        <% if (errors.length > 0) { %>
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    <% errors.forEach(error => { %>
                                        <li><%= error %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        <% } %>

                        <!-- Order Summary -->
                        <div class="alert alert-light">
                            <h5>Order Summary</h5>
                            <p><strong>Services:</strong></p>
                            <ul>
                                <% order.Categories.forEach(category => { %>
                                    <li>
                                        <%= category.name %> - <%= category.OrderCategory.quantity %> kg
                                    </li>
                                <% }); %>
                            </ul>
                            <p><strong>Total Paid:</strong> Rp <%= order.totalPrice.toLocaleString('id-ID') %></p>
                            <p><strong>Completed Date:</strong> <%= new Date(order.updatedAt).toLocaleDateString('id-ID') %></p>
                        </div>

                        <form method="POST" action="/review/<%= order.id %>">
                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <select class="form-select" id="rating" name="rating" required>
                                    <option value="">Select Rating</option>
                                    <option value="5">⭐⭐⭐⭐⭐ Excellent (5/5)</option>
                                    <option value="4">⭐⭐⭐⭐☆ Very Good (4/5)</option>
                                    <option value="3">⭐⭐⭐☆☆ Good (3/5)</option>
                                    <option value="2">⭐⭐☆☆☆ Fair (2/5)</option>
                                    <option value="1">⭐☆☆☆☆ Poor (1/5)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="text" class="form-label">Review</label>
                                <textarea class="form-control" id="text" name="text" rows="5" 
                                          placeholder="Share your experience with our laundry service..." required></textarea>
                                <div class="form-text">Tell other customers about the quality of service, timeliness, and overall experience.</div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="/" class="btn btn-secondary me-md-2">Cancel</a>
                                <button type="submit" class="btn btn-primary">Submit Review</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Review Guidelines -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h6>Review Guidelines:</h6>
                        <ul class="small text-muted mb-0">
                            <li>Be honest and constructive in your feedback</li>
                            <li>Focus on the service quality, cleanliness, and timeliness</li>
                            <li>Help other customers make informed decisions</li>
                            <li>Keep your review respectful and professional</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>