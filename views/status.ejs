<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LaundryApp - Order Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">🧺 LaundryApp</a>
            <div class="navbar-nav ms-auto">
                <a href="/order" class="btn btn-outline-light me-2">New Order</a>
                <a href="/" class="btn btn-outline-light me-2">Home</a>
                <a href="/logout" class="btn btn-outline-light">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Success/Error Messages -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Your Order Status</h2>
                
                <div class="mb-4">
                    <a href="/admins" class="btn btn-outline-secondary">
                        📞 Show Admin Contacts
                    </a>
                </div>
                <% if (orders.length > 0) { %>
                    <div class="row">
                        <% orders.forEach(order => { %>
                            <div class="col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Order #<%= order.id %></h5>
                                        <span class="badge bg-<%= order.status === 'Processing' ? 'warning' : order.status === 'In Progress' ? 'info' : 'success' %>">
                                            <%= order.status %>
                                        </span>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <strong>Services:</strong>
                                            <ul class="mb-2">
                                                <% order.Categories.forEach(category => { %>
                                                    <li>
                                                        <%= category.name %> - <%= category.OrderCategory.quantity %> kg
                                                        <br><small class="text-muted">
                                                            Rp <%= category.price.toLocaleString('id-ID') %> /kg
                                                        </small>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>

                                        <div class="mb-3">
                                            <strong>Total Price:</strong> 
                                            <span class="text-success">Rp <%= order.totalPrice.toLocaleString('id-ID') %></span>
                                        </div>

                                        <div class="mb-3">
                                            <strong>Distance:</strong> <%= order.distance %> km
                                        </div>

                                        <div class="mb-3">
                                            <strong>Order Date:</strong> 
                                            <%= new Date(order.createdAt).toLocaleDateString('id-ID') %>
                                        </div>

                                        <div class="mb-3">
                                        <% const daysLeft = estimateDaysLeft(order.createdAt, order.weight); %>
                                        <strong>Estimated Days Left:</strong>
                                        <% if (daysLeft > 0) { %>
                                            <span class="badge bg-info"><%= formatTimeRemaining(daysLeft) %></span>
                                        <% } else { %>
                                            <span class="badge bg-success">Ready for pickup!</span>
                                        <% } %>
                                        </div>

                                        <% if (order.status !== 'Completed') { %>
                                            <form method="POST" action="/order/<%= order.id %>/done" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm" 
                                                        onclick="return confirm('Mark this order as completed?')">
                                                    Mark as Done
                                                </button>
                                            </form>
                                             <form method="POST" action="/order/<%= order.id %>/delete" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm" 
                                                        onclick="return confirm('Are you sure you want to delete this order?')">
                                                    Delete
                                                </button>
                                            </form>

                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="alert alert-info text-center">
                        <h4>No pending orders</h4>
                        <p>You don't have any pending orders at the moment.</p>
                        <a href="/order" class="btn btn-primary">Place New Order</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>